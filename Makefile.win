EXTENSION = pgturbohybrid pgturbohybrid_experimental
EXTVERSION = 0.2.0

SHLIB = pgturbohybrid.dll
DATA = sql\pgturbohybrid--0.1.0.sql sql\pgturbohybrid--0.1.1.sql sql\pgturbohybrid--0.1.2.sql sql\pgturbohybrid--0.2.0.sql sql\pgturbohybrid_experimental--0.2.0.sql sql\pgturbohybrid--0.1.0--0.1.1.sql sql\pgturbohybrid--0.1.1--0.1.2.sql sql\pgturbohybrid--0.1.2--0.2.0.sql

# Windows build profile (see docs/compatibility.md): MSVC compiles the portable
# scalar code paths only. The hand-vectorized SIMD kernels the Unix build
# compiles -- pgturbohybrid_quant_score_u8_x86, pgturbohybrid_quant_score_signed_x86,
# pgturbohybrid_quant_score_arm, pgturbohybrid_sparse_simd_x86, and
# pgturbohybrid_sparse_simd_arm -- are intentionally omitted from OBJS below:
# they use GCC/clang __attribute__((target(...))) + __builtin_cpu_supports, which
# MSVC does not support. Their callers fall back to the scalar implementations in
# pgturbohybrid_quant_score / pgturbohybrid_sparse_score. This OBJS list must
# otherwise match the Unix Makefile; scripts/check-build-file-parity.py enforces
# that the only differences are those five intentionally-omitted SIMD objects.
OBJS = \
	src\pgturbohybrid.obj \
	src\pgturbohybrid_am.obj \
	src\pgturbohybrid_bm25_build.obj \
	src\pgturbohybrid_bm25_query.obj \
	src\pgturbohybrid_build.obj \
	src\pgturbohybrid_graph.obj \
	src\pgturbohybrid_graph_utils.obj \
	src\pgturbohybrid_guc.obj \
	src\pgturbohybrid_insert.obj \
	src\pgturbohybrid_multivector.obj \
	src\pgturbohybrid_quant.obj \
	src\pgturbohybrid_quant_multivector_scan.obj \
	src\pgturbohybrid_quant_vacuum.obj \
	src\pgturbohybrid_quant_cache.obj \
	src\pgturbohybrid_quant_exact.obj \
	src\pgturbohybrid_quant_insert.obj \
	src\pgturbohybrid_quant_psquare.obj \
	src\pgturbohybrid_quant_scan_cache.obj \
	src\pgturbohybrid_quant_score.obj \
	src\pgturbohybrid_quant_storage.obj \
	src\pgturbohybrid_query.obj \
	src\pgturbohybrid_scan.obj \
	src\pgturbohybrid_sparse_build.obj \
	src\pgturbohybrid_sparse_primary.obj \
	src\pgturbohybrid_sparse_query.obj \
	src\pgturbohybrid_sparse_score.obj \
	src\pgturbohybrid_diagnostics.obj \
	src\pgturbohybrid_validate.obj \
	src\pgturbohybrid_vacuum.obj \
	src\pgturbohybrid_vector_compat.obj

HEADERS =

# Windows runs a reduced regression subset: the SIMD-independent,
# output-deterministic tests (catalog comments, GUC defaults, diagnostic key
# types, query-wrapper equivalence, and input fuzzing). Score/ranking-sensitive
# suites (sparse, multivector, SIMD parity, rescore, querysplit, codebook,
# u8split, nibble_guard, x4_safety) stay Unix-only because the MSVC scalar build
# can differ in the last ULP of scored output. scripts/check-build-file-parity.py
# enforces that this difference stays intentional. See docs/compatibility.md.
REGRESS = extension pgturbohybrid pgturbohybrid_comments pgturbohybrid_gucs pgturbohybrid_guc_defaults pgturbohybrid_diagnostics pgturbohybrid_query pgturbohybrid_wrappers pgturbohybrid_fuzz security
REGRESS_OPTS = --inputdir=test
REGRESS = $(REGRESS) pgturbohybrid_validate

SIMD_BUILD = portable
MATH_MODE = strict
PGTURBOHYBRID_REQUIRE_VECTOR_HEADER = 1

!ifndef PGROOT
!error PGROOT is not set
!endif

BINDIR = $(PGROOT)\bin
INCLUDEDIR = $(PGROOT)\include
INCLUDEDIR_SERVER = $(PGROOT)\include\server
LIBDIR = $(PGROOT)\lib
PKGLIBDIR = $(PGROOT)\lib
SHAREDIR = $(PGROOT)\share

PG_REGRESS = $(LIBDIR)\pgxs\src\test\regress\pg_regress

PGVECTOR_INSTALLED_INCLUDE = $(INCLUDEDIR_SERVER)\extension\vector
PGVECTOR_HEADER =

!if exist("$(PGVECTOR_INSTALLED_INCLUDE)\vector.h")
PGVECTOR_HEADER = $(PGVECTOR_INSTALLED_INCLUDE)\vector.h
PGVECTOR_CFLAGS = /I"$(PGVECTOR_INSTALLED_INCLUDE)"
!elseif "$(VECTOR_INCLUDE)" != ""
!if exist("$(VECTOR_INCLUDE)\vector.h")
PGVECTOR_HEADER = $(VECTOR_INCLUDE)\vector.h
PGVECTOR_CFLAGS = /I"$(VECTOR_INCLUDE)"
!else
!error VECTOR_INCLUDE must point to a directory containing vector.h
!endif
!endif

!if "$(PGTURBOHYBRID_REQUIRE_VECTOR_HEADER)" == "1"
!if "$(PGVECTOR_HEADER)" == ""
!error pgvector header vector.h not found; install pgvector headers or set VECTOR_INCLUDE=\path\to\pgvector\include\server\extension\vector
!endif
PGVECTOR_CFLAGS = $(PGVECTOR_CFLAGS) /DPGTURBOHYBRID_USE_PGVECTOR_HEADER=1
!endif

!if "$(SIMD_BUILD)" == "none"
SIMD_CFLAGS = /DPGTURBOHYBRID_DISABLE_SIMD=1
!elseif "$(SIMD_BUILD)" == "portable"
SIMD_CFLAGS =
!else
!error unsupported SIMD_BUILD=$(SIMD_BUILD); expected portable or none
!endif

!if "$(MATH_MODE)" == "fast"
MATH_CFLAGS = /fp:fast
!elseif "$(MATH_MODE)" == "strict"
MATH_CFLAGS = /fp:precise
!else
!error unsupported MATH_MODE=$(MATH_MODE); expected strict or fast
!endif

PG_CFLAGS = $(PG_CFLAGS) /O2 $(MATH_CFLAGS) $(SIMD_CFLAGS)

CFLAGS = /nologo /I"$(INCLUDEDIR_SERVER)\port\win32_msvc" /I"$(INCLUDEDIR_SERVER)\port\win32" /I"$(INCLUDEDIR_SERVER)" /I"$(INCLUDEDIR)" $(PGVECTOR_CFLAGS)
CFLAGS = $(CFLAGS) $(PG_CFLAGS)

LIBS = "$(LIBDIR)\postgres.lib"

all: $(SHLIB)

.c.obj:
	$(CC) $(CFLAGS) /c $< /Fo$@

$(SHLIB): $(OBJS)
	$(CC) $(CFLAGS) $(OBJS) $(LIBS) /link /DLL /OUT:$(SHLIB)

install: all
	copy /Y $(SHLIB) "$(PKGLIBDIR)"
	copy /Y $(EXTENSION).control "$(SHAREDIR)\extension"
	copy /Y sql\$(EXTENSION)--*.sql "$(SHAREDIR)\extension"

installcheck:
	"$(PG_REGRESS)" --bindir="$(BINDIR)" $(REGRESS_OPTS) $(REGRESS)

uninstall:
	if exist "$(PKGLIBDIR)\$(SHLIB)" del /f "$(PKGLIBDIR)\$(SHLIB)"
	if exist "$(SHAREDIR)\extension\$(EXTENSION).control" del /f "$(SHAREDIR)\extension\$(EXTENSION).control"
	if exist "$(SHAREDIR)\extension\$(EXTENSION)--*.sql" del /f "$(SHAREDIR)\extension\$(EXTENSION)--*.sql"

clean:
	if exist $(SHLIB) del /f $(SHLIB)
	if exist $(EXTENSION).lib del /f $(EXTENSION).lib
	if exist $(EXTENSION).exp del /f $(EXTENSION).exp
	del /f $(OBJS)
	del /f /s /q results regression.diffs regression.out tmp_check tmp_check_iso log output_iso
