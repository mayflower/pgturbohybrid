{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pgturbohybrid benchmark result",
  "type": "object",
  "required": ["suite", "layer", "results"],
  "properties": {
    "suite": {
      "type": "string"
    },
    "layer": {
      "enum": ["ir_quality", "systems", "reference", "ir_quality_and_systems", "external_dense_vector_library"]
    },
    "generated_at_unix": {
      "type": "integer"
    },
    "command": {
      "type": "object",
      "properties": {
        "executable": { "type": "string" },
        "argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "full_argv": {
          "type": "array",
          "items": { "type": "string" }
        },
        "shell": { "type": "string" },
        "cwd": { "type": "string" },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "dataset": {
      "type": "string"
    },
    "dataset_name": {
      "type": "string"
    },
    "dataset_path": {
      "type": "string"
    },
    "query_source": {
      "type": "string"
    },
    "rows": {
      "type": "integer"
    },
    "queries": {
      "type": "integer"
    },
    "warmup": {
      "type": "integer"
    },
    "measured_runs": {
      "type": "integer"
    },
    "method": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "multivector_proxy_encoder": { "type": "string" },
        "multivector_centroids": { "type": "string" },
        "multivector_centroid_count": { "type": ["string", "integer"] },
        "multivector_sparse_candidate_source": { "type": "string" },
        "learned_sparse_doc_jsonl": { "type": ["string", "null"] },
        "learned_sparse_query_jsonl": { "type": ["string", "null"] },
        "skip_parallel_retrieval": { "type": "boolean" },
        "force_parallel_retrieval": { "type": "boolean" },
        "document_node_proxy_encoder_grid": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "method": { "type": "string" },
          "variant": { "type": "string" },
          "retrieval_mode": { "type": "string" },
          "profile": { "type": "string" },
          "dense_k": { "type": "integer" },
          "bm25_k": { "type": "integer" },
          "rrf_k": { "type": "integer" },
          "final_k": { "type": "integer" },
          "failure_probe_k": { "type": "integer" },
          "status": { "enum": ["ok", "failed", "partial"] },
          "error": {
            "type": "object",
            "additionalProperties": true
          },
          "index_bytes": { "type": "integer" },
          "bytes_per_vector": { "type": "number" },
          "build_ms": { "type": "number" },
          "build_seconds": { "type": "number" },
          "build_provenance": {
            "type": "object",
            "properties": {
              "build_source": { "type": "string" },
              "build_key": { "type": "string" },
              "provenance_confidence": { "type": "string" },
              "dense_build_exact_distances": { "type": ["boolean", "null"] },
              "index_dense_build_exact_distances": { "type": ["boolean", "null"] },
              "exact_storage": { "type": ["boolean", "null"] },
              "quantization_bits": { "type": ["integer", "null"] },
              "graph_backbone": { "type": ["boolean", "null"] },
              "index_graph_backbone": { "type": ["boolean", "null"] },
              "entry_sidecar": { "type": ["boolean", "null"] },
              "residual_rerank": { "type": ["boolean", "null"] }
            },
            "additionalProperties": true
          },
          "latency": {
            "type": "object",
            "properties": {
              "p50_ms": { "type": "number" },
              "p95_ms": { "type": "number" },
              "p99_ms": { "type": "number" },
              "mean_ms": { "type": "number" },
              "qps": { "type": "number" },
              "runs": { "type": "integer" }
            },
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "source_rank_summary": {
            "type": "object",
            "additionalProperties": true
          },
          "failure_attribution": {
            "type": "object",
            "additionalProperties": true
          },
          "scan_summary": {
            "type": "object",
            "additionalProperties": true
          },
          "parallel_8x": {
            "type": "object",
            "properties": {
              "clients": { "type": "integer" },
              "warm_queries_per_client": { "type": "integer" },
              "timed_queries_per_client": { "type": "integer" },
              "total_timed_queries": { "type": "integer" },
              "failed": { "type": "boolean" },
              "skipped": { "type": "boolean" },
              "skip_reason": { "type": "string" },
              "error": { "type": "string" },
              "throughput_qps": { "type": "number" },
              "warm_latency": { "type": "object", "additionalProperties": true },
              "timed_latency": { "type": "object", "additionalProperties": true },
              "safety_preflight": {
                "type": "object",
                "properties": {
                  "enabled": { "type": "boolean" },
                  "forced": { "type": "boolean" },
                  "method": { "type": "string" },
                  "skipped": { "type": "boolean" },
                  "reasons": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "thresholds": { "type": "object", "additionalProperties": true },
                  "observed": { "type": "object", "additionalProperties": true }
                },
                "additionalProperties": true
              }
            },
            "additionalProperties": true
          },
          "index_stats": {
            "type": ["object", "null"],
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "admission_debug": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "candidate_source": { "type": "string" },
        "sparse_candidate_source": { "type": "string" },
        "retrieval_method": { "type": "string" },
        "aggregate": {
          "type": "object",
          "properties": {
            "queries": { "type": "integer" },
            "admission_k": { "type": "integer" },
            "budget_sweep": {
              "type": "array",
              "items": { "type": "integer" }
            },
            "exact_top1_admission": { "type": "number" },
            "exact_top1_admitted": { "type": "number" },
            "exact_top1_admission_rate": { "type": "number" },
            "exact_top10_admission_recall": { "type": "number" },
            "exact_top1_first_budget_admitted": { "type": "object", "additionalProperties": true },
            "first_budget_admitting_exact_top1": { "type": "object", "additionalProperties": true },
            "admission_by_budget": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "exact_top1_admission": { "type": "number" },
                  "exact_top1_admitted": { "type": "number" },
                  "exact_top10_admission_recall": { "type": "number" },
                  "latency": { "type": "object", "additionalProperties": true },
                  "docs_scored": { "type": "object", "additionalProperties": true },
                  "graph_edges_visited": { "type": "object", "additionalProperties": true },
                  "exact_rerank_docs": { "type": "object", "additionalProperties": true },
                  "exact_rerank_tokens_evaluated": { "type": "object", "additionalProperties": true },
                  "exact_rerank_tokens_skipped": { "type": "object", "additionalProperties": true },
                  "exact_rerank_pairs_saved": { "type": "object", "additionalProperties": true },
                  "proxy_candidates": { "type": "object", "additionalProperties": true },
                  "proxy_exact_rerank_docs": { "type": "object", "additionalProperties": true },
                  "centroid_lists_visited": { "type": "object", "additionalProperties": true },
                  "centroid_docs_touched": { "type": "object", "additionalProperties": true },
                  "centroid_pruned_docs": { "type": "object", "additionalProperties": true },
                  "centroid_candidates": { "type": "object", "additionalProperties": true },
                  "quantized_inverted_candidates": { "type": "object", "additionalProperties": true },
                  "quantized_inverted_postings_touched": { "type": "object", "additionalProperties": true },
                  "quantized_inverted_docs_scored": { "type": "object", "additionalProperties": true },
                  "learned_sparse_candidates": { "type": "object", "additionalProperties": true },
                  "learned_sparse_retained_for_maxsim": { "type": "object", "additionalProperties": true },
                  "learned_sparse_branch_latency_us": { "type": "object", "additionalProperties": true }
                },
                "additionalProperties": true
              }
            }
          },
          "additionalProperties": true
        },
        "per_query": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "exact_top1_admission": { "type": "boolean" },
              "exact_top1_admitted": { "type": "boolean" },
              "exact_top10_admission_recall": { "type": "number" },
              "exact_top1_rank": { "type": ["integer", "null"] },
              "admission_inferred_from_result_docs": { "type": "boolean" },
              "latency": { "type": "object", "additionalProperties": true },
              "docs_scored": { "type": "integer" },
              "graph_edges_visited": { "type": "integer" },
              "exact_rerank_docs": { "type": "integer" },
              "exact_rerank_candidates": { "type": "integer" },
              "exact_rerank_tokens_evaluated": { "type": "integer" },
              "exact_rerank_tokens_skipped": { "type": "integer" },
              "exact_rerank_pairs_saved": { "type": "integer" },
              "adaptive_rerank_topk_changed_vs_full": { "type": "boolean" },
              "proxy_encoder_kind": { "type": ["string", "null"] },
              "proxy_candidates": { "type": "integer" },
              "proxy_top1_admission": { "type": "boolean" },
              "proxy_exact_rerank_docs": { "type": "integer" },
              "centroid_lists_visited": { "type": "integer" },
              "centroid_docs_touched": { "type": "integer" },
              "centroid_pruned_docs": { "type": "integer" },
              "centroid_candidates": { "type": "integer" },
              "quantized_inverted_lists_visited": { "type": "integer" },
              "quantized_inverted_postings_touched": { "type": "integer" },
              "quantized_inverted_docs_scored": { "type": "integer" },
              "quantized_inverted_candidates": { "type": "integer" },
              "quantized_inverted_exact_rerank_docs": { "type": "integer" },
              "quantized_inverted_codebook_size": { "type": "integer" },
              "learned_sparse_candidates": { "type": "integer" },
              "learned_sparse_retained_for_maxsim": { "type": "integer" },
              "learned_sparse_branch_latency_us": { "type": "integer" },
              "doc_graph_storage_kind": { "type": ["string", "null"] },
              "doc_graph_rescore_source": { "type": ["string", "null"] }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "hybrid_evaluation": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "rebuilds_index": { "type": "boolean" },
        "modes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "queries": { "type": "integer" },
        "best_quality_mode": { "type": ["string", "null"] },
        "best_latency_under_quality_floor_mode": { "type": ["string", "null"] },
        "recommended_default_profile": {
          "type": "object",
          "additionalProperties": true
        },
        "profile_recommendations": {
          "type": "object",
          "additionalProperties": true
        },
        "results": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "mode": { "type": "string" },
              "metrics": { "type": "object", "additionalProperties": { "type": "number" } },
              "latency": { "type": "object", "additionalProperties": true },
              "exact_top1_admission_rate": { "type": "number" },
              "exact_top10_admission_recall": { "type": "number" },
              "scan_work": { "type": "object", "additionalProperties": true },
              "admission_inferred_from_result_docs_queries": { "type": "integer" },
              "candidate_admission_failures": { "type": "object", "additionalProperties": true },
              "failure_query_count": { "type": "integer" },
              "top10_by_query": { "type": "object", "additionalProperties": true }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "per_query_recovery_overlap": {
      "type": "object",
      "additionalProperties": true
    },
    "environment": {
      "type": "object"
    },
    "per_query_jsonl": {
      "type": "string"
    },
    "index_report": {
      "type": "string"
    },
    "markdown_report": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
