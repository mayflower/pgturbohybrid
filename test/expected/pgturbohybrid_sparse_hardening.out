-- Sparse hardening pass: edge cases + error guards across the
-- supported key-map shapes.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
RESET client_min_messages;
-- ============================================================ payload edges
-- Empty sparse vector is valid and builds an empty bag.
SELECT turbohybrid_sparse_vector_term_ids(
  turbohybrid_sparse_vector_build(ARRAY[]::int4[], ARRAY[]::float4[])) AS empty_ids;
 empty_ids 
-----------
 {}
(1 row)

-- Huge (but valid) term ids and duplicate terms (summed by default).
SELECT turbohybrid_sparse_vector_term_ids(
         turbohybrid_sparse_vector_build(ARRAY[2147483000, 5, 5]::int4[],
                                         ARRAY[1.0, 2.0, 3.0]::float4[])) AS ids,
       turbohybrid_sparse_vector_weights(
         turbohybrid_sparse_vector_build(ARRAY[2147483000, 5, 5]::int4[],
                                         ARRAY[1.0, 2.0, 3.0]::float4[])) AS weights;
      ids       | weights 
----------------+---------
 {5,2147483000} | {5,1}
(1 row)

-- Negative term ids and invalid options are rejected.
DO $$
DECLARE spec record;
BEGIN
  FOR spec IN
    SELECT 'neg_term' AS name,
           $q$SELECT turbohybrid_sparse_vector_build(ARRAY[-1]::int4[], ARRAY[1.0]::float4[])$q$ AS sql
    UNION ALL SELECT 'bad_dedup',
           $q$SELECT turbohybrid_sparse_vector_build(ARRAY[1]::int4[], ARRAY[1.0]::float4[], '{"deduplicate":"bogus"}')$q$
    UNION ALL SELECT 'neg_top_k',
           $q$SELECT turbohybrid_sparse_vector_build(ARRAY[1]::int4[], ARRAY[1.0]::float4[], '{"top_k":-1}')$q$
  LOOP
    BEGIN
      EXECUTE spec.sql;
      RAISE EXCEPTION 'expected % to fail', spec.name;
    EXCEPTION WHEN OTHERS THEN
      NULL;
    END;
  END LOOP;
END $$;
-- ============================================================ key-map shapes
CREATE TABLE sh (
  id int,
  embedding vector(3),
  body tsvector,
  s turbohybrid_sparse_vector
);
INSERT INTO sh VALUES
  (1, '[1,0,0]', to_tsvector('simple','alpha common'),
      turbohybrid_sparse_vector_build(ARRAY[2,9]::int4[], ARRAY[10.0,1.0]::float4[])),
  (2, '[0,1,0]', to_tsvector('simple','beta common'),
      turbohybrid_sparse_vector_build(ARRAY[2,9]::int4[], ARRAY[20.0,1.0]::float4[])),
  (3, '[0,0,1]', to_tsvector('simple','gamma common'),
      turbohybrid_sparse_vector_build(ARRAY[2,9]::int4[], ARRAY[30.0,1.0]::float4[]));
-- All four supported shapes build; bm25-only / tsvector-only is unsupported.
CREATE INDEX sh_dense_sparse ON sh USING turbohybrid
  (embedding vector_cosine_turbohybrid_ops, s sparse_ip_turbohybrid_ops);
DROP INDEX sh_dense_sparse;
CREATE INDEX sh_sparse_only ON sh USING turbohybrid (s sparse_ip_turbohybrid_ops);
DROP INDEX sh_sparse_only;
CREATE INDEX sh_sparse_bm25 ON sh USING turbohybrid
  (s sparse_ip_turbohybrid_ops, body bm25_tsvector_turbohybrid_ops);
DROP INDEX sh_sparse_bm25;
CREATE INDEX sh_dense_sparse_bm25 ON sh USING turbohybrid
  (embedding vector_cosine_turbohybrid_ops, s sparse_ip_turbohybrid_ops,
   body bm25_tsvector_turbohybrid_ops);
DROP INDEX sh_dense_sparse_bm25;
-- sparse_query against an index with no sparse key is rejected.
CREATE INDEX sh_dense_only ON sh USING turbohybrid (embedding vector_cosine_turbohybrid_ops);
SET enable_seqscan = off;
DO $$
BEGIN
  PERFORM id FROM sh ORDER BY embedding <~> turbohybrid_query(
    vector_query => '[1,0,0]'::vector,
    sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[]),
    fusion => 'rrf') LIMIT 5;
  RAISE EXCEPTION 'expected sparse_query without a sparse key to fail';
EXCEPTION WHEN feature_not_supported THEN
  NULL;
END $$;
-- A dense-only scan exposes the sparse stat fields as zero/false (no spurious
-- sparse activity when the sparse branch is unused).
DO $$
DECLARE st jsonb;
BEGIN
  SET LOCAL enable_seqscan = off;
  PERFORM id FROM sh ORDER BY embedding <~> turbohybrid_query(
    vector_query => '[1,0,0]'::vector) LIMIT 3;
  st := turbohybrid_last_scan_stats();
  IF st->>'sparse_branch_used' != 'false'
     OR (st->>'sparse_candidates')::int != 0
     OR (st->>'sparse_postings_touched')::int != 0 THEN
    RAISE EXCEPTION 'dense-only scan reported spurious sparse activity: %', st;
  END IF;
END $$;
DROP INDEX sh_dense_only;
-- ============================================================ sparse-only edges
CREATE INDEX sh_sp ON sh USING turbohybrid (s sparse_ip_turbohybrid_ops)
  WITH (sparse_quant_bits = 0);
-- term 9 is a high-df term (in every doc); query it + LIMIT.
SELECT id FROM sh ORDER BY s <~*> turbohybrid_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[9]::int4[], ARRAY[1.0]::float4[])) LIMIT 2;
 id 
----
  1
  2
(2 rows)

-- sparse-only ranking by the discriminating term, with LIMIT.
SELECT id FROM sh ORDER BY s <~*> turbohybrid_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 2;
 id 
----
  3
  2
(2 rows)

-- SIMD disabled still returns the same ranking.
SET turbohybrid.simd = off;
SELECT id FROM sh ORDER BY s <~*> turbohybrid_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 3;
 id 
----
  3
  2
  1
(3 rows)

RESET turbohybrid.simd;
DROP INDEX sh_sp;
-- ============================================================ hybrid LIMIT
CREATE INDEX sh_hybrid ON sh USING turbohybrid
  (embedding vector_cosine_turbohybrid_ops, s sparse_ip_turbohybrid_ops);
SELECT id FROM sh ORDER BY embedding <~> turbohybrid_query(
  vector_query => '[0,0,1]'::vector,
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[]),
  fusion => 'rrf') LIMIT 3;
 id 
----
  3
  1
  2
(3 rows)

DROP INDEX sh_hybrid;
RESET enable_seqscan;
DROP TABLE sh;
