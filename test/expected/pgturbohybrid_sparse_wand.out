-- Block-max WAND pruning for sparse postings (Prompt 9): WAND-on must return
-- the same top-k as WAND-off (exact), pruning must reduce scored documents, and
-- indexes built without a block-max directory fall back to exact accumulation.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
RESET client_min_messages;
-- Fixture: term 1 (common) in 60 docs with distinct weights = id; term 2 (rare)
-- in docs 1..3; term 3 (medium) in docs 10..30.  Small block size so WAND has
-- multiple blocks per term to skip.
CREATE TABLE sw (id int, embedding vector(3), s turbohybrid_sparse_vector);
INSERT INTO sw
SELECT g, '[1,0,0]',
       CASE
         WHEN g <= 3 THEN
           turbohybrid_sparse_vector_build(ARRAY[1,2]::int4[], ARRAY[g::float4, (60-g)::float4])
         WHEN g BETWEEN 10 AND 30 THEN
           turbohybrid_sparse_vector_build(ARRAY[1,3]::int4[], ARRAY[g::float4, g::float4])
         ELSE
           turbohybrid_sparse_vector_build(ARRAY[1]::int4[], ARRAY[g::float4])
       END
FROM generate_series(1, 60) g;
CREATE INDEX sw_idx ON sw USING turbohybrid
  (embedding vector_cosine_turbohybrid_ops, s sparse_ip_turbohybrid_ops)
  WITH (sparse_quant_bits = 8, sparse_block_size = 8);
SET enable_seqscan = off;
SET turbohybrid.sparse_rerank = off;   -- compare the raw WAND vs exact top-k
-- WAND-on == WAND-off for single / common / rare / medium / multi-term queries.
DO $$
DECLARE
  spec text;
  ids_wand int[];
  ids_exact int[];
BEGIN
  FOREACH spec IN ARRAY ARRAY[
    'turbohybrid_sparse_vector_build(ARRAY[1]::int4[], ARRAY[1.0]::float4[])',
    'turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])',
    'turbohybrid_sparse_vector_build(ARRAY[3]::int4[], ARRAY[1.0]::float4[])',
    'turbohybrid_sparse_vector_build(ARRAY[1,2]::int4[], ARRAY[1.0,2.0]::float4[])',
    'turbohybrid_sparse_vector_build(ARRAY[1,3]::int4[], ARRAY[1.0,1.0]::float4[])']
  LOOP
    SET LOCAL enable_seqscan = off;
    SET LOCAL turbohybrid.sparse_rerank = off;
    SET LOCAL turbohybrid.enable_sparse_wand = on;
    EXECUTE format($q$ SELECT array_agg(id) FROM (
      SELECT id FROM sw ORDER BY s <~*> turbohybrid_query(sparse_query => %s, sparse_k => 5)
      LIMIT 5) q $q$, spec) INTO ids_wand;

    SET LOCAL turbohybrid.enable_sparse_wand = off;
    EXECUTE format($q$ SELECT array_agg(id) FROM (
      SELECT id FROM sw ORDER BY s <~*> turbohybrid_query(sparse_query => %s, sparse_k => 5)
      LIMIT 5) q $q$, spec) INTO ids_exact;

    IF ids_wand IS DISTINCT FROM ids_exact THEN
      RAISE EXCEPTION 'WAND/exact mismatch for %: wand=% exact=%', spec, ids_wand, ids_exact;
    END IF;
  END LOOP;
END $$;
-- Block-max WAND ran and the top-5 of the common term are the 5 highest weights.
SELECT id FROM sw
ORDER BY s <~*> turbohybrid_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[1]::int4[], ARRAY[1.0]::float4[]),
  sparse_k => 5)
LIMIT 5;
 id 
----
 60
 59
 58
 57
 56
(5 rows)

DO $$
DECLARE st jsonb;
BEGIN
  SET LOCAL enable_seqscan = off;
  SET LOCAL turbohybrid.enable_sparse_wand = on;
  PERFORM id FROM sw ORDER BY s <~*> turbohybrid_query(
    sparse_query => turbohybrid_sparse_vector_build(ARRAY[1]::int4[], ARRAY[1.0]::float4[]),
    sparse_k => 5) LIMIT 5;
  st := turbohybrid_last_scan_stats();
  IF st->>'sparse_used_wand' != 'true' THEN
    RAISE EXCEPTION 'expected WAND to run: %', st;
  END IF;
  IF (st->>'sparse_wand_iterations')::int < 1 THEN
    RAISE EXCEPTION 'expected WAND iterations: %', st;
  END IF;
END $$;
-- Pruning: a dominant rare term (weight 100, 1 doc) with k=1 lets WAND skip the
-- 100 low-weight docs entirely (it scores far fewer than the 101 matched docs).
CREATE TABLE swd (id int, embedding vector(3), s turbohybrid_sparse_vector);
INSERT INTO swd VALUES
  (1, '[1,0,0]', turbohybrid_sparse_vector_build(ARRAY[10]::int4[], ARRAY[100.0]::float4[]));
INSERT INTO swd
SELECT g, '[0,1,0]', turbohybrid_sparse_vector_build(ARRAY[20]::int4[], ARRAY[1.0]::float4[])
FROM generate_series(2, 101) g;
CREATE INDEX swd_idx ON swd USING turbohybrid
  (embedding vector_cosine_turbohybrid_ops, s sparse_ip_turbohybrid_ops)
  WITH (sparse_quant_bits = 8, sparse_block_size = 8);
SET enable_seqscan = off;
SET turbohybrid.sparse_rerank = off;
-- Top-1 of {10:1, 20:1} is doc 1 (score ~100), not any of the 100 weight-1 docs.
SELECT id FROM swd
ORDER BY s <~*> turbohybrid_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[10,20]::int4[], ARRAY[1.0,1.0]::float4[]),
  sparse_k => 1)
LIMIT 1;
 id 
----
  1
(1 row)

DO $$
DECLARE st jsonb;
BEGIN
  SET LOCAL enable_seqscan = off;
  SET LOCAL turbohybrid.enable_sparse_wand = on;
  PERFORM id FROM swd ORDER BY s <~*> turbohybrid_query(
    sparse_query => turbohybrid_sparse_vector_build(ARRAY[10,20]::int4[], ARRAY[1.0,1.0]::float4[]),
    sparse_k => 1) LIMIT 1;
  st := turbohybrid_last_scan_stats();
  -- WAND evaluates far fewer than the 101 matched docs.
  IF (st->>'sparse_candidates_scored')::int >= 101 THEN
    RAISE EXCEPTION 'WAND should reduce scored docs, scored %', st->>'sparse_candidates_scored';
  END IF;
  IF (st->>'sparse_wand_pruned')::int = 0 AND (st->>'sparse_blocks_skipped')::int = 0 THEN
    RAISE EXCEPTION 'expected WAND pruning (pruned or blocks skipped): %', st;
  END IF;
END $$;
DROP INDEX swd_idx;
DROP TABLE swd;
-- Fallback: an index built without a block-max directory uses exact accumulation
-- even when WAND is enabled.
DROP INDEX sw_idx;
CREATE INDEX sw_nobm ON sw USING turbohybrid
  (embedding vector_cosine_turbohybrid_ops, s sparse_ip_turbohybrid_ops)
  WITH (sparse_quant_bits = 8, sparse_block_max = false);
SET enable_seqscan = off;
DO $$
DECLARE st jsonb;
BEGIN
  SET LOCAL enable_seqscan = off;
  SET LOCAL turbohybrid.enable_sparse_wand = on;
  PERFORM id FROM sw ORDER BY s <~*> turbohybrid_query(
    sparse_query => turbohybrid_sparse_vector_build(ARRAY[1]::int4[], ARRAY[1.0]::float4[]),
    sparse_k => 5) LIMIT 5;
  st := turbohybrid_last_scan_stats();
  IF st->>'sparse_used_wand' != 'false' THEN
    RAISE EXCEPTION 'no block-max directory should fall back to exact: %', st;
  END IF;
END $$;
DROP INDEX sw_nobm;
RESET turbohybrid.enable_sparse_wand;
RESET turbohybrid.sparse_rerank;
RESET enable_seqscan;
DROP TABLE sw;
