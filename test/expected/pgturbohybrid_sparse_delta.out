-- Sparse delta insert/update/delete + compaction.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
RESET client_min_messages;
CREATE TABLE sdl (id int, embedding vector(3), s turbohybrid_sparse_vector);
INSERT INTO sdl VALUES
  (1, '[1,0,0]', turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[10.0]::float4[])),
  (2, '[0,1,0]', turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[20.0]::float4[])),
  (3, '[0,0,1]', turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[30.0]::float4[]));
CREATE INDEX sdl_idx ON sdl USING turbohybrid
  (embedding vector_cosine_turbohybrid_ops, s sparse_ip_turbohybrid_ops);
SET enable_seqscan = off;
-- Query term {2:1.0}: base order by descending weight = doc3, doc2, doc1.
SELECT id, round((s <~*> turbohybrid_experimental_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])))::numeric, 2) AS dist
FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10;
 id |  dist  
----+--------
  3 | -30.00
  2 | -20.00
  1 | -10.00
(3 rows)

-- INSERT after build: doc4 weight 25 is searchable via the delta (between 2 and 3).
INSERT INTO sdl VALUES (4, '[1,1,0]', turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[25.0]::float4[]));
SELECT id, round((s <~*> turbohybrid_experimental_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])))::numeric, 2) AS dist
FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10;
 id |  dist  
----+--------
  3 | -30.00
  4 | -25.00
  2 | -20.00
  1 | -10.00
(4 rows)

DO $$
DECLARE st jsonb;
BEGIN
  SET LOCAL enable_seqscan = off;
  PERFORM id FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
    sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10;
  st := turbohybrid_last_scan_stats();
  IF st->>'sparse_used_wand' != 'false' THEN
    RAISE EXCEPTION 'pending deltas must force the exact path (not WAND): %', st;
  END IF;
  IF (st->>'sparse_delta_pages')::int < 1 THEN
    RAISE EXCEPTION 'expected a delta document: %', st;
  END IF;
END $$;
-- UPDATE: change doc1 from weight 10 to weight 40 (now the top match).
UPDATE sdl SET s = turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[40.0]::float4[]) WHERE id = 1;
SELECT id FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10;
 id 
----
  1
  3
  4
  2
(4 rows)

-- DELETE: remove doc3 (weight 30); it must not appear.
DELETE FROM sdl WHERE id = 3;
SELECT id FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10;
 id 
----
  1
  4
  2
(3 rows)

-- base+delta ranking == REINDEX ranking (REINDEX rebuilds the base from the heap).
DO $$
DECLARE
  before_ids int[];
  after_ids int[];
BEGIN
  SET LOCAL enable_seqscan = off;
  SELECT array_agg(id) INTO before_ids FROM (
    SELECT id FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
      sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10) q;
  REINDEX INDEX sdl_idx;
  SELECT array_agg(id) INTO after_ids FROM (
    SELECT id FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
      sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10) q;
  IF before_ids IS DISTINCT FROM after_ids THEN
    RAISE EXCEPTION 'base+delta ranking % != REINDEX ranking %', before_ids, after_ids;
  END IF;
END $$;
-- Re-insert a delta, then explicit compaction: ranking preserved, delta cleared,
-- and WAND resumes (the rebuilt base has a block-max directory and no deltas).
INSERT INTO sdl VALUES (5, '[1,0,1]', turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[15.0]::float4[]));
DO $$
DECLARE
  before_ids int[];
  after_ids int[];
  st jsonb;
BEGIN
  SET LOCAL enable_seqscan = off;
  SELECT array_agg(id) INTO before_ids FROM (
    SELECT id FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
      sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10) q;
  PERFORM turbohybrid_sparse_compact('sdl_idx'::regclass);
  SELECT array_agg(id) INTO after_ids FROM (
    SELECT id FROM sdl ORDER BY s <~*> turbohybrid_experimental_query(
      sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 10) q;
  IF before_ids IS DISTINCT FROM after_ids THEN
    RAISE EXCEPTION 'compaction changed ranking: % -> %', before_ids, after_ids;
  END IF;
  st := turbohybrid_last_scan_stats();
  IF st->>'sparse_used_wand' != 'true' OR (st->>'sparse_delta_pages')::int != 0 THEN
    RAISE EXCEPTION 'compaction should clear the delta and resume WAND: %', st;
  END IF;
END $$;
RESET enable_seqscan;
DROP TABLE sdl;
