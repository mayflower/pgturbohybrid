-- pgturbohybrid_diagnostics: a dense scan must emit the documented STABLE
-- diagnostic keys of turbohybrid_last_scan_stats() with their expected jsonb
-- types. See docs/diagnostics-schema.md and src/pgturbohybrid_diagnostics.h.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
RESET client_min_messages;
CREATE TABLE diag (id int, e vector(8));
INSERT INTO diag
SELECT g, ARRAY[g, g + 1, g + 2, g + 3, g + 4, g + 5, g + 6, g + 7]::float4[]::vector
FROM generate_series(1, 200) g;
CREATE INDEX ON diag USING turbohybrid (e vector_cosine_turbohybrid_ops);
SET enable_seqscan = off;
-- Run a dense scan so the backend records scan stats.
SELECT count(*) FROM (
  SELECT id FROM diag
  ORDER BY e <~> turbohybrid_query(vector_query => (SELECT e FROM diag WHERE id = 1), final_k => 10)
  LIMIT 10
) q;
 count 
-------
    10
(1 row)

-- Each stable key must be present, with the documented jsonb type.
WITH s AS (SELECT turbohybrid_last_scan_stats() AS j)
SELECT k AS stable_key,
       (j ? k) AS present,
       jsonb_typeof(j -> k) AS jsonb_type
FROM s, unnest(ARRAY[
  'scan_orchestration', 'score_mode', 'dimensions', 'quantization_bits',
  'final_k_effective', 'dense_branch_used', 'dense_scorer', 'graph_storage_kind',
  'dense_k_effective', 'graph_visited_nodes', 'graph_scored_codes',
  'branch_count', 'branch_fusion_mode', 'native_cache_scope'
]) AS k
ORDER BY k;
     stable_key      | present | jsonb_type 
---------------------+---------+------------
 branch_count        | t       | number
 branch_fusion_mode  | t       | string
 dense_branch_used   | t       | boolean
 dense_k_effective   | t       | number
 dense_scorer        | t       | string
 dimensions          | t       | number
 final_k_effective   | t       | number
 graph_scored_codes  | t       | number
 graph_storage_kind  | t       | string
 graph_visited_nodes | t       | number
 native_cache_scope  | t       | string
 quantization_bits   | t       | number
 scan_orchestration  | t       | string
 score_mode          | t       | string
(14 rows)

RESET enable_seqscan;
DROP TABLE diag;
