-- pgturbohybrid_comments: the public SQL surface must be self-documenting.
-- Every key object carries a COMMENT ON whose text includes one of the maturity
-- tags [stable public] / [experimental public] / [research-only] / [diagnostic]
-- / [internal helper].  These mirror docs/feature-matrix.md.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid_experimental;
RESET client_min_messages;
-- Per-object check: each key public object has a comment carrying a maturity tag.
SELECT kind, name, has_comment, has_label
FROM (
    SELECT 'extension'::text AS kind, 'pgturbohybrid'::text AS name,
           obj_description(e.oid, 'pg_extension') AS d
      FROM pg_extension e WHERE e.extname = 'pgturbohybrid'
    UNION ALL
    SELECT 'access method', a.amname, obj_description(a.oid, 'pg_am')
      FROM pg_am a WHERE a.amname = 'turbohybrid'
    UNION ALL
    SELECT 'type', t.typname, obj_description(t.oid, 'pg_type')
      FROM pg_type t
      WHERE t.typname IN ('turbohybrid_query', 'turbohybrid_sparse_vector',
                          'turbohybrid_multivector')
    UNION ALL
    SELECT 'opclass', oc.opcname, obj_description(oc.oid, 'pg_opclass')
      FROM pg_opclass oc JOIN pg_am a ON a.oid = oc.opcmethod
      WHERE a.amname = 'turbohybrid'
    UNION ALL
    SELECT 'function', p.proname, obj_description(p.oid, 'pg_proc')
      FROM pg_proc p
      WHERE p.proname IN ('turbohybrid_query', 'turbohybrid_index_stats',
                          'turbohybrid_last_scan_stats', 'turbohybrid_estimate_memory',
                          'turbohybrid_experimental_compact_code_score')
) s
CROSS JOIN LATERAL (
    SELECT s.d IS NOT NULL AS has_comment,
           s.d ~ '\[(stable public|experimental public|research-only|diagnostic|internal helper)\]'
             AS has_label
) chk
ORDER BY kind, name;
     kind      |                    name                     | has_comment | has_label 
---------------+---------------------------------------------+-------------+-----------
 access method | turbohybrid                                 | t           | t
 extension     | pgturbohybrid                               | t           | t
 function      | turbohybrid_estimate_memory                 | t           | t
 function      | turbohybrid_experimental_compact_code_score | t           | t
 function      | turbohybrid_index_stats                     | t           | t
 function      | turbohybrid_last_scan_stats                 | t           | t
 function      | turbohybrid_query                           | t           | t
 opclass       | bm25_tsvector_turbohybrid_ops               | t           | t
 opclass       | multivector_cosine_turbohybrid_ops          | t           | t
 opclass       | multivector_maxsim_ip_turbohybrid_ops       | t           | t
 opclass       | sparse_ip_turbohybrid_ops                   | t           | t
 opclass       | vector_cosine_turbohybrid_ops               | t           | t
 opclass       | vector_ip_turbohybrid_ops                   | t           | t
 opclass       | vector_l2_turbohybrid_ops                   | t           | t
 type          | turbohybrid_multivector                     | t           | t
 type          | turbohybrid_query                           | t           | t
 type          | turbohybrid_sparse_vector                   | t           | t
(17 rows)

-- The experimental scorer must be explicitly research-only.
SELECT obj_description(p.oid, 'pg_proc') ~ 'research-only' AS scorer_is_research_only
FROM pg_proc p
WHERE p.proname = 'turbohybrid_experimental_compact_code_score';
 scorer_is_research_only 
-------------------------
 t
(1 row)

-- Completeness: no turbohybrid-prefixed function may be left uncommented.
SELECT count(*) AS uncommented_turbohybrid_functions
FROM pg_proc p
WHERE p.proname LIKE 'turbohybrid\_%'
  AND obj_description(p.oid, 'pg_proc') IS NULL;
 uncommented_turbohybrid_functions 
-----------------------------------
                                 0
(1 row)

-- Completeness: every turbohybrid operator class and family is commented.
SELECT count(*) AS uncommented_turbohybrid_opclasses
FROM pg_opclass oc
JOIN pg_am a ON a.oid = oc.opcmethod
WHERE a.amname = 'turbohybrid'
  AND obj_description(oc.oid, 'pg_opclass') IS NULL;
 uncommented_turbohybrid_opclasses 
-----------------------------------
                                 0
(1 row)

