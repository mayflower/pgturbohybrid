SET enable_seqscan = off;
CREATE TABLE tq_rescore_data AS
SELECT id, ARRAY(
    SELECT sin(0.123 * (k + id))::real FROM generate_series(0, 63) k
)::vector(64) AS val
FROM generate_series(1, 32) id;
CREATE INDEX tq_rescore_exact_idx ON tq_rescore_data
  USING turboquant (val vector_cosine_ops)
  WITH (routing = graph, tq_bits = 4, tq_exact_storage = on);
DO $$
DECLARE
    top_id int;
BEGIN
    SELECT id INTO top_id
    FROM tq_rescore_data
    ORDER BY val <=> (SELECT val FROM tq_rescore_data WHERE id = 11)
    LIMIT 1;

    IF top_id != 11 THEN
        RAISE EXCEPTION 'expected exact-storage self-match id 11, got %', top_id;
    END IF;
END
$$;
DROP INDEX tq_rescore_exact_idx;
CREATE INDEX tq_rescore_quantized_idx ON tq_rescore_data
  USING turboquant (val vector_cosine_ops)
  WITH (routing = graph, tq_bits = 4, tq_exact_storage = off);
DO $$
DECLARE
    found_row bool;
BEGIN
    SELECT id IS NOT NULL INTO found_row
    FROM tq_rescore_data
    ORDER BY val <=> (SELECT val FROM tq_rescore_data WHERE id = 11)
    LIMIT 1;

    IF NOT found_row THEN
        RAISE EXCEPTION 'expected quantized search to return a row';
    END IF;
END
$$;
DROP TABLE tq_rescore_data;
