DO $$
BEGIN
	IF EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'pgturbohybrid') THEN
		EXECUTE 'DROP EXTENSION pgturbohybrid CASCADE';
	END IF;
	IF EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'vector') THEN
		EXECUTE 'DROP EXTENSION vector CASCADE';
	END IF;
END
$$;
CREATE EXTENSION vector;
CREATE EXTENSION pgturbohybrid;
DO $$
DECLARE
	settings text[];
BEGIN
	SELECT array_agg(name ORDER BY name) INTO settings
	FROM pg_settings
	WHERE name LIKE 'turbohybrid.%';

	IF settings <> ARRAY[
		'turbohybrid.bm25_accumulator_mode',
		'turbohybrid.bm25_common_term_fallback_min_postings',
		'turbohybrid.bm25_heap_tsvector_rerank',
		'turbohybrid.bm25_heap_tsvector_rerank_multiplier',
		'turbohybrid.bm25_heap_tsvector_rerank_weight',
		'turbohybrid.bm25_hot_postings_cache_mb',
		'turbohybrid.bm25_hot_postings_cache_min_df',
		'turbohybrid.bm25_hybrid_bound',
		'turbohybrid.bm25_impact_or_mode',
		'turbohybrid.bm25_strategy',
		'turbohybrid.calibrated_fusion_both_match_bonus',
		'turbohybrid.calibrated_fusion_broad_dense_alpha',
		'turbohybrid.calibrated_fusion_default_alpha',
		'turbohybrid.calibrated_fusion_identifier_bm25_alpha',
		'turbohybrid.dbsf_min_branch_candidates',
		'turbohybrid.dbsf_robust',
		'turbohybrid.dbsf_sigma',
		'turbohybrid.default_bm25_k',
		'turbohybrid.default_dense_k',
		'turbohybrid.default_rrf_k',
		'turbohybrid.default_sparse_k',
		'turbohybrid.dense_adaptive_min_gap',
		'turbohybrid.dense_adaptive_widening',
		'turbohybrid.dense_adaptive_widening_max_multiplier',
		'turbohybrid.dense_adaptive_widening_multiplier',
		'turbohybrid.dense_build_distance',
		'turbohybrid.dense_build_exact_distances',
		'turbohybrid.dense_build_neighbor_select',
		'turbohybrid.dense_graph_avx512vnni',
			'turbohybrid.dense_graph_avxvnni',
			'turbohybrid.dense_heap_rescore',
			'turbohybrid.dense_local_expansion',
		'turbohybrid.dense_local_expansion_max_neighbors',
		'turbohybrid.dense_local_expansion_topn',
		'turbohybrid.dense_query_split_impl',
		'turbohybrid.dense_rescore_band',
		'turbohybrid.dense_residual_rerank_band_multiplier',
		'turbohybrid.dense_residual_rerank_max_adjust_ratio',
		'turbohybrid.dense_residual_rerank_mode',
		'turbohybrid.dense_residual_rerank_weight',
		'turbohybrid.dense_u8_batch_x4',
		'turbohybrid.dense_u8_split',
		'turbohybrid.dense_uncertainty_min_gap',
		'turbohybrid.dense_uncertainty_retry',
		'turbohybrid.dense_uncertainty_retry_max_passes',
		'turbohybrid.dense_uncertainty_retry_multiplier',
		'turbohybrid.enable_wand',
		'turbohybrid.fast_weighted_score_bound_pruning',
		'turbohybrid.final_diversity',
		'turbohybrid.final_diversity_lambda',
		'turbohybrid.final_diversity_payload_slot',
		'turbohybrid.final_diversity_pool_multiplier',
		'turbohybrid.hybrid_budget_policy',
		'turbohybrid.linear_fallback_notice_threshold_ratio',
		'turbohybrid.max_union_candidates',
		'turbohybrid.multivector_adaptive_widening',
		'turbohybrid.multivector_allow_exact_symmetric_build',
		'turbohybrid.multivector_bm25_candidate_injection',
		'turbohybrid.multivector_branch_plan',
		'turbohybrid.multivector_candidate_reservoirs',
					'turbohybrid.multivector_candidate_source',
					'turbohybrid.multivector_centroid_lite_bitset_min_token_matches',
					'turbohybrid.multivector_centroid_lite_bitset_prefilter',
					'turbohybrid.multivector_centroid_lite_candidate_scoring',
					'turbohybrid.multivector_centroid_lite_codeword_top_m',
					'turbohybrid.multivector_centroid_lite_max_postings_per_token',
					'turbohybrid.multivector_centroid_lite_posting_selection',
					'turbohybrid.multivector_centroid_lite_probe_centroids_per_token',
			'turbohybrid.multivector_centroid_lite_pruning',
					'turbohybrid.multivector_centroid_lite_score_drop_from_best',
					'turbohybrid.multivector_centroid_lite_score_threshold',
		'turbohybrid.multivector_coverage_reservoir_k',
		'turbohybrid.multivector_debug_admission',
		'turbohybrid.multivector_debug_skip_query_tokens',
		'turbohybrid.multivector_debug_trace_limit',
		'turbohybrid.multivector_doc_candidate_k',
		'turbohybrid.multivector_doc_graph_entry_sample_count',
		'turbohybrid.multivector_doc_graph_oversampling',
		'turbohybrid.multivector_doc_graph_rescore_k',
		'turbohybrid.multivector_doc_graph_search_ef',
		'turbohybrid.multivector_doc_storage',
		'turbohybrid.multivector_doc_storage_cache',
		'turbohybrid.multivector_docmap',
		'turbohybrid.multivector_exact_rerank',
		'turbohybrid.multivector_exact_rerank_k',
		'turbohybrid.multivector_exact_symmetric_build_max_docs',
		'turbohybrid.multivector_learned_projection_checksum',
		'turbohybrid.multivector_learned_projection_model',
		'turbohybrid.multivector_learned_projection_path',
		'turbohybrid.multivector_max_accumulator_mb',
		'turbohybrid.multivector_max_dim',
		'turbohybrid.multivector_max_doc_vectors',
		'turbohybrid.multivector_max_query_vectors',
		'turbohybrid.multivector_max_raw_hits_per_token',
		'turbohybrid.multivector_model_name',
			'turbohybrid.multivector_per_token_doc_reservoir_k',
			'turbohybrid.multivector_plain_fallback',
		'turbohybrid.multivector_plain_fallback_candidate_fraction',
		'turbohybrid.multivector_plain_fallback_max_docs',
		'turbohybrid.multivector_proxy_encoder',
		'turbohybrid.multivector_quantized_inverted_codebook',
						'turbohybrid.multivector_quantized_inverted_codebook_path',
							'turbohybrid.multivector_quantized_inverted_codebook_top_m',
							'turbohybrid.multivector_quantized_inverted_compact_doc_order',
							'turbohybrid.multivector_quantized_inverted_compact_max_docs',
							'turbohybrid.multivector_quantized_inverted_compact_scoring',
						'turbohybrid.multivector_quantized_inverted_max_postings_per_token',
						'turbohybrid.multivector_quantized_inverted_min_token_matches',
						'turbohybrid.multivector_quantized_inverted_posting_selection',
						'turbohybrid.multivector_quantized_inverted_precompact',
						'turbohybrid.multivector_quantized_inverted_precompact_coverage_k',
						'turbohybrid.multivector_quantized_inverted_precompact_per_token_k',
						'turbohybrid.multivector_quantized_inverted_precompact_score_k',
						'turbohybrid.multivector_quantized_inverted_probe_codewords_per_token',
						'turbohybrid.multivector_quantized_inverted_pruning',
						'turbohybrid.multivector_quantized_inverted_query_codeword_kernel',
						'turbohybrid.multivector_quantized_inverted_token_coverage',
				'turbohybrid.multivector_sparse_candidate_source',
		'turbohybrid.multivector_subvector_k',
		'turbohybrid.multivector_unique_docs_per_token',
		'turbohybrid.native_build_workers',
		'turbohybrid.native_cache_max_mb',
		'turbohybrid.native_cache_policy',
		'turbohybrid.native_cache_scope',
		'turbohybrid.native_cache_warn_mb',
		'turbohybrid.native_parallel_edge_build',
		'turbohybrid.native_segment_budget',
		'turbohybrid.payload_entry_seed_count',
		'turbohybrid.payload_entry_seeding',
		'turbohybrid.profile',
		'turbohybrid.simd',
		'turbohybrid.warn_linear_fallback'
	] THEN
		RAISE EXCEPTION 'unexpected pgturbohybrid settings: %', settings;
	END IF;

	IF current_setting('turbohybrid.profile') != 'latency' THEN
		RAISE EXCEPTION 'unexpected default turbohybrid profile: %',
			current_setting('turbohybrid.profile');
	END IF;
	IF current_setting('turbohybrid.native_build_workers') != '2' THEN
		RAISE EXCEPTION 'unexpected default native build workers: %',
			current_setting('turbohybrid.native_build_workers');
	END IF;
	IF current_setting('turbohybrid.native_parallel_edge_build') != 'auto' THEN
		RAISE EXCEPTION 'unexpected default native parallel edge build: %',
			current_setting('turbohybrid.native_parallel_edge_build');
	END IF;
	IF current_setting('turbohybrid.multivector_max_doc_vectors') != '256' OR
		current_setting('turbohybrid.multivector_max_query_vectors') != '64' OR
		current_setting('turbohybrid.multivector_subvector_k') != '100' OR
		current_setting('turbohybrid.multivector_unique_docs_per_token') != '100' OR
		current_setting('turbohybrid.multivector_max_raw_hits_per_token') != '400' OR
			current_setting('turbohybrid.multivector_adaptive_widening') != 'auto' OR
			current_setting('turbohybrid.multivector_branch_plan') != 'auto' OR
				current_setting('turbohybrid.multivector_candidate_source') != 'graph' OR
				current_setting('turbohybrid.multivector_centroid_lite_bitset_prefilter') != 'off' OR
				current_setting('turbohybrid.multivector_centroid_lite_bitset_min_token_matches') != '1' OR
				current_setting('turbohybrid.multivector_centroid_lite_candidate_scoring') != 'posting_payload' OR
				current_setting('turbohybrid.multivector_centroid_lite_codeword_top_m') != '1' OR
				current_setting('turbohybrid.multivector_centroid_lite_probe_centroids_per_token') != '1' OR
				current_setting('turbohybrid.multivector_centroid_lite_posting_selection') != 'uniform_stride' OR
				current_setting('turbohybrid.multivector_centroid_lite_score_drop_from_best') != '-1' OR
				current_setting('turbohybrid.multivector_centroid_lite_score_threshold') != '-1' OR
			current_setting('turbohybrid.multivector_centroid_lite_pruning') != 'off' OR
		current_setting('turbohybrid.multivector_bm25_candidate_injection') != 'off' OR
		current_setting('turbohybrid.multivector_sparse_candidate_source') != 'off' OR
		current_setting('turbohybrid.multivector_candidate_reservoirs') != 'conservative' OR
		current_setting('turbohybrid.multivector_coverage_reservoir_k') != '10' OR
		current_setting('turbohybrid.multivector_plain_fallback') != 'auto' OR
		current_setting('turbohybrid.multivector_plain_fallback_candidate_fraction') != '0.5' OR
		current_setting('turbohybrid.multivector_plain_fallback_max_docs') != '1000' OR
		current_setting('turbohybrid.multivector_per_token_doc_reservoir_k') != '1' OR
		current_setting('turbohybrid.multivector_docmap') != 'auto' OR
		current_setting('turbohybrid.multivector_doc_candidate_k') != '100' OR
		current_setting('turbohybrid.multivector_doc_graph_entry_sample_count') != '0' OR
		current_setting('turbohybrid.multivector_doc_graph_search_ef') != '0' OR
		current_setting('turbohybrid.multivector_doc_graph_oversampling') != '1' OR
		current_setting('turbohybrid.multivector_doc_graph_rescore_k') != '0' OR
		current_setting('turbohybrid.multivector_doc_storage') != 'f32' OR
		current_setting('turbohybrid.multivector_doc_storage_cache') != 'auto' OR
		current_setting('turbohybrid.multivector_exact_rerank') != 'adaptive' OR
		current_setting('turbohybrid.multivector_exact_rerank_k') != '100' OR
		current_setting('turbohybrid.multivector_allow_exact_symmetric_build') != 'off' OR
		current_setting('turbohybrid.multivector_exact_symmetric_build_max_docs') != '1000' OR
		current_setting('turbohybrid.multivector_learned_projection_checksum') != '' OR
		current_setting('turbohybrid.multivector_learned_projection_model') != '' OR
		current_setting('turbohybrid.multivector_learned_projection_path') != '' OR
		current_setting('turbohybrid.multivector_model_name') != '' OR
		current_setting('turbohybrid.multivector_proxy_encoder') != 'normalized_mean' OR
		current_setting('turbohybrid.multivector_quantized_inverted_codebook') != 'deterministic' OR
					current_setting('turbohybrid.multivector_quantized_inverted_codebook_path') != '' OR
					current_setting('turbohybrid.multivector_quantized_inverted_codebook_top_m') != '1' OR
					current_setting('turbohybrid.multivector_quantized_inverted_compact_doc_order') != 'docid' OR
					current_setting('turbohybrid.multivector_quantized_inverted_compact_scoring') != 'off' OR
						current_setting('turbohybrid.multivector_quantized_inverted_precompact') != 'off' OR
						current_setting('turbohybrid.multivector_quantized_inverted_precompact_score_k') != '4096' OR
						current_setting('turbohybrid.multivector_quantized_inverted_precompact_coverage_k') != '512' OR
						current_setting('turbohybrid.multivector_quantized_inverted_precompact_per_token_k') != '16' OR
						current_setting('turbohybrid.multivector_quantized_inverted_compact_max_docs') != '6144' OR
						current_setting('turbohybrid.multivector_quantized_inverted_token_coverage') != 'off' OR
						current_setting('turbohybrid.multivector_quantized_inverted_max_postings_per_token') != '0' OR
						current_setting('turbohybrid.multivector_quantized_inverted_min_token_matches') != '0' OR
						current_setting('turbohybrid.multivector_quantized_inverted_pruning') != 'off' OR
						current_setting('turbohybrid.multivector_quantized_inverted_query_codeword_kernel') != 'auto' OR
					current_setting('turbohybrid.multivector_quantized_inverted_probe_codewords_per_token') != '1' OR
					current_setting('turbohybrid.multivector_quantized_inverted_posting_selection') != 'score_topk' OR
				current_setting('turbohybrid.multivector_max_accumulator_mb') != '64' OR
			current_setting('turbohybrid.multivector_debug_admission') != 'off' OR
			current_setting('turbohybrid.multivector_debug_skip_query_tokens') != '' OR
			current_setting('turbohybrid.multivector_debug_trace_limit') != '1000' THEN
						RAISE EXCEPTION 'unexpected multivector defaults: doc %, query %, subvector %, unique %, raw %, adaptive %, branch_plan %, source %, centroid_lite_bitset_prefilter %, centroid_lite_bitset_min_token_matches %, centroid_lite_candidate_scoring %, centroid_lite_codeword_top_m %, centroid_lite_probe_centroids %, centroid_lite_posting_selection %, centroid_lite_score_drop_from_best %, centroid_lite_score_threshold %, centroid_lite_pruning %, bm25_injection %, sparse_source %, reservoirs %, coverage_reservoir_k %, fallback %, fallback_fraction %, fallback_max_docs %, per_token_reservoir_k %, docmap %, docs %, doc_graph_entry_sample_count %, doc_graph_search_ef %, doc_graph_oversampling %, doc_graph_rescore_k %, doc_storage %, doc_storage_cache %, rerank %, rerank_k %, allow_exact_symmetric_build %, exact_symmetric_build_max_docs %, learned_projection_checksum %, learned_projection_model %, learned_projection_path %, model %, proxy_encoder %, quantized_codebook %, quantized_codebook_path %, quantized_codebook_top_m %, quantized_compact_doc_order %, quantized_compact_scoring %, quantized_token_coverage %, quantized_posting_limit %, quantized_min_token_matches %, quantized_pruning %, quantized_probe_codewords %, quantized_posting_selection %, accumulator_mb %, debug %, skip_tokens %, trace_limit %',
				current_setting('turbohybrid.multivector_max_doc_vectors'),
			current_setting('turbohybrid.multivector_max_query_vectors'),
			current_setting('turbohybrid.multivector_subvector_k'),
			current_setting('turbohybrid.multivector_unique_docs_per_token'),
			current_setting('turbohybrid.multivector_max_raw_hits_per_token'),
			current_setting('turbohybrid.multivector_adaptive_widening'),
			current_setting('turbohybrid.multivector_branch_plan'),
				current_setting('turbohybrid.multivector_candidate_source'),
				current_setting('turbohybrid.multivector_centroid_lite_bitset_prefilter'),
				current_setting('turbohybrid.multivector_centroid_lite_bitset_min_token_matches'),
				current_setting('turbohybrid.multivector_centroid_lite_candidate_scoring'),
				current_setting('turbohybrid.multivector_centroid_lite_codeword_top_m'),
				current_setting('turbohybrid.multivector_centroid_lite_probe_centroids_per_token'),
				current_setting('turbohybrid.multivector_centroid_lite_posting_selection'),
				current_setting('turbohybrid.multivector_centroid_lite_score_drop_from_best'),
				current_setting('turbohybrid.multivector_centroid_lite_score_threshold'),
			current_setting('turbohybrid.multivector_centroid_lite_pruning'),
			current_setting('turbohybrid.multivector_bm25_candidate_injection'),
			current_setting('turbohybrid.multivector_sparse_candidate_source'),
			current_setting('turbohybrid.multivector_candidate_reservoirs'),
			current_setting('turbohybrid.multivector_coverage_reservoir_k'),
			current_setting('turbohybrid.multivector_plain_fallback'),
			current_setting('turbohybrid.multivector_plain_fallback_candidate_fraction'),
			current_setting('turbohybrid.multivector_plain_fallback_max_docs'),
			current_setting('turbohybrid.multivector_per_token_doc_reservoir_k'),
			current_setting('turbohybrid.multivector_docmap'),
			current_setting('turbohybrid.multivector_doc_candidate_k'),
			current_setting('turbohybrid.multivector_doc_graph_entry_sample_count'),
			current_setting('turbohybrid.multivector_doc_graph_search_ef'),
			current_setting('turbohybrid.multivector_doc_graph_oversampling'),
			current_setting('turbohybrid.multivector_doc_graph_rescore_k'),
			current_setting('turbohybrid.multivector_doc_storage'),
			current_setting('turbohybrid.multivector_doc_storage_cache'),
			current_setting('turbohybrid.multivector_exact_rerank'),
			current_setting('turbohybrid.multivector_exact_rerank_k'),
			current_setting('turbohybrid.multivector_allow_exact_symmetric_build'),
			current_setting('turbohybrid.multivector_exact_symmetric_build_max_docs'),
			current_setting('turbohybrid.multivector_learned_projection_checksum'),
			current_setting('turbohybrid.multivector_learned_projection_model'),
			current_setting('turbohybrid.multivector_learned_projection_path'),
			current_setting('turbohybrid.multivector_model_name'),
			current_setting('turbohybrid.multivector_proxy_encoder'),
				current_setting('turbohybrid.multivector_quantized_inverted_codebook'),
				current_setting('turbohybrid.multivector_quantized_inverted_codebook_path'),
				current_setting('turbohybrid.multivector_quantized_inverted_codebook_top_m'),
					current_setting('turbohybrid.multivector_quantized_inverted_compact_doc_order'),
					current_setting('turbohybrid.multivector_quantized_inverted_compact_scoring'),
				current_setting('turbohybrid.multivector_quantized_inverted_token_coverage'),
				current_setting('turbohybrid.multivector_quantized_inverted_max_postings_per_token'),
				current_setting('turbohybrid.multivector_quantized_inverted_min_token_matches'),
				current_setting('turbohybrid.multivector_quantized_inverted_pruning'),
				current_setting('turbohybrid.multivector_quantized_inverted_probe_codewords_per_token'),
				current_setting('turbohybrid.multivector_quantized_inverted_posting_selection'),
			current_setting('turbohybrid.multivector_max_accumulator_mb'),
			current_setting('turbohybrid.multivector_debug_admission'),
			current_setting('turbohybrid.multivector_debug_skip_query_tokens'),
			current_setting('turbohybrid.multivector_debug_trace_limit');
	END IF;
	IF current_setting('turbohybrid.payload_entry_seeding') != 'auto' OR
		current_setting('turbohybrid.payload_entry_seed_count') != '8' THEN
		RAISE EXCEPTION 'unexpected default payload entry seeding settings: mode %, count %',
			current_setting('turbohybrid.payload_entry_seeding'),
			current_setting('turbohybrid.payload_entry_seed_count');
	END IF;

	IF current_setting('turbohybrid.final_diversity') != 'off' OR
		current_setting('turbohybrid.final_diversity_payload_slot') != '-1' OR
		current_setting('turbohybrid.final_diversity_lambda') != '0.75' OR
		current_setting('turbohybrid.final_diversity_pool_multiplier') != '3' THEN
		RAISE EXCEPTION 'unexpected final diversity defaults: mode %, slot %, lambda %, pool multiplier %',
			current_setting('turbohybrid.final_diversity'),
			current_setting('turbohybrid.final_diversity_payload_slot'),
			current_setting('turbohybrid.final_diversity_lambda'),
			current_setting('turbohybrid.final_diversity_pool_multiplier');
	END IF;

	IF current_setting('turbohybrid.calibrated_fusion_both_match_bonus') != '0.06' OR
		current_setting('turbohybrid.calibrated_fusion_identifier_bm25_alpha') != '0.35' OR
		current_setting('turbohybrid.calibrated_fusion_broad_dense_alpha') != '0.7' OR
		current_setting('turbohybrid.calibrated_fusion_default_alpha') != '0.5' THEN
		RAISE EXCEPTION 'unexpected calibrated fusion defaults: bonus %, identifier %, broad %, default %',
			current_setting('turbohybrid.calibrated_fusion_both_match_bonus'),
			current_setting('turbohybrid.calibrated_fusion_identifier_bm25_alpha'),
			current_setting('turbohybrid.calibrated_fusion_broad_dense_alpha'),
			current_setting('turbohybrid.calibrated_fusion_default_alpha');
	END IF;

		IF current_setting('turbohybrid.dense_adaptive_widening') != 'off' OR
			current_setting('turbohybrid.dense_heap_rescore') != 'off' OR
			current_setting('turbohybrid.dense_local_expansion') != 'off' OR
			current_setting('turbohybrid.dense_residual_rerank_mode') != 'calibrated' OR
			current_setting('turbohybrid.dense_uncertainty_retry') != 'off' OR
			current_setting('turbohybrid.native_segment_budget') != 'auto' OR
			current_setting('turbohybrid.dense_build_distance') != 'auto' OR
			current_setting('turbohybrid.dense_build_exact_distances') != 'off' THEN
			RAISE EXCEPTION 'unexpected latency dense defaults: adaptive %, heap %, local %, residual %, uncertainty retry %, segment budget %, build distance %, exact build %',
				current_setting('turbohybrid.dense_adaptive_widening'),
				current_setting('turbohybrid.dense_heap_rescore'),
				current_setting('turbohybrid.dense_local_expansion'),
				current_setting('turbohybrid.dense_residual_rerank_mode'),
				current_setting('turbohybrid.dense_uncertainty_retry'),
				current_setting('turbohybrid.native_segment_budget'),
				current_setting('turbohybrid.dense_build_distance'),
				current_setting('turbohybrid.dense_build_exact_distances');
		END IF;

	IF current_setting('turbohybrid.bm25_strategy') != 'auto' OR
		current_setting('turbohybrid.bm25_impact_or_mode') != 'approx' OR
		current_setting('turbohybrid.bm25_hot_postings_cache_mb') != '32' OR
		current_setting('turbohybrid.bm25_hot_postings_cache_min_df') != '1024' OR
		current_setting('turbohybrid.bm25_hybrid_bound') != 'approx' OR
		current_setting('turbohybrid.bm25_accumulator_mode') != 'auto' THEN
		RAISE EXCEPTION 'unexpected latency BM25 defaults: strategy %, impact_or %, cache %, min_df %, bound %, accumulator %',
			current_setting('turbohybrid.bm25_strategy'),
			current_setting('turbohybrid.bm25_impact_or_mode'),
			current_setting('turbohybrid.bm25_hot_postings_cache_mb'),
			current_setting('turbohybrid.bm25_hot_postings_cache_min_df'),
			current_setting('turbohybrid.bm25_hybrid_bound'),
			current_setting('turbohybrid.bm25_accumulator_mode');
	END IF;

	IF current_setting('turbohybrid.dbsf_sigma')::float8 != 3.0 OR
		current_setting('turbohybrid.dbsf_min_branch_candidates')::int != 10 OR
		current_setting('turbohybrid.dbsf_robust') != 'off' THEN
		RAISE EXCEPTION 'unexpected DBSF defaults: sigma %, min_branch_candidates %, robust %',
			current_setting('turbohybrid.dbsf_sigma'),
			current_setting('turbohybrid.dbsf_min_branch_candidates'),
			current_setting('turbohybrid.dbsf_robust');
	END IF;
END
