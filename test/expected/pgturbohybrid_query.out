SET turbohybrid.bm25_impact_or_mode = off;
SET turbohybrid.bm25_hot_postings_cache_mb = 7;
SET turbohybrid.bm25_hybrid_bound = off;
SET turbohybrid.bm25_accumulator_mode = hash;
SET turbohybrid.simd = off;
