		fusion => 'calibrated',
		alpha => 0.65,
		final_k => 5
	))::text != 'turbohybrid_query(fusion=calibrated,vector=true,tsquery=true,dense_weight=1,bm25_weight=1,alpha=0.65,rrf_k=60,dense_k=100,bm25_k=100,final_k=5,require_bm25_match=false)' THEN
		RAISE EXCEPTION 'unexpected calibrated turbohybrid_query output';
	END IF;
END
