SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
RESET client_min_messages;
SELECT round(('[1,0,0]'::vector <~> turbohybrid_query(
	vector_query => '[1,0,0]'::vector))::numeric, 6) AS cosine_distance;
 cosine_distance 
-----------------
        0.000000
(1 row)

SELECT round(('[1,2,3]'::vector <~-> turbohybrid_query(
	vector_query => '[1,2,5]'::vector))::numeric, 6) AS l2_distance;
 l2_distance 
-------------
    2.000000
(1 row)

SELECT round(('[1,2,3]'::vector <~#> turbohybrid_query(
	vector_query => '[2,0,1]'::vector))::numeric, 6) AS negative_inner_product;
 negative_inner_product 
------------------------
              -5.000000
(1 row)

DO $$
BEGIN
	PERFORM turbohybrid_query(fusion => 'unknown');
	RAISE EXCEPTION 'invalid fusion was accepted';
EXCEPTION WHEN invalid_parameter_value THEN
	NULL;
END
$$;
DO $$
BEGIN
	PERFORM turbohybrid_query(dense_weight => '-1'::float8);
	RAISE EXCEPTION 'negative weight was accepted';
EXCEPTION WHEN invalid_parameter_value THEN
	NULL;
END
$$;
