-- Bit-packed sparse postings encoding: must be exactly equivalent to the
-- offset16_soa and varint encodings (the encoding changes only how node_ids are
-- physically addressed, never the scores).  Exercises small/large deltas,
-- single-posting and high-df terms, multi-chunk terms (small block size), WAND,
-- and the f32/q8/q16 bit widths.
SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
RESET client_min_messages;
CREATE TABLE bp (id int, s turbohybrid_sparse_vector);
-- 24 docs.  term 2: in every doc (high-df, dense -> small deltas), weight grows.
-- term 5: sparse (every 5th doc -> larger deltas).  term 9: a single doc.
-- term 3: a clustered run then a far gap (mixes small + one large delta).
INSERT INTO bp
SELECT g,
  turbohybrid_sparse_vector_build(
    (ARRAY[2]
     || CASE WHEN g % 5 = 0 THEN ARRAY[5] ELSE ARRAY[]::int4[] END
     || CASE WHEN g = 7 THEN ARRAY[9] ELSE ARRAY[]::int4[] END
     || CASE WHEN g < 4 OR g = 20 THEN ARRAY[3] ELSE ARRAY[]::int4[] END)::int4[],
    (ARRAY[(g + 1)::float4]
     || CASE WHEN g % 5 = 0 THEN ARRAY[2.0::float4] ELSE ARRAY[]::float4[] END
     || CASE WHEN g = 7 THEN ARRAY[9.0::float4] ELSE ARRAY[]::float4[] END
     || CASE WHEN g < 4 OR g = 20 THEN ARRAY[4.0::float4] ELSE ARRAY[]::float4[] END)::float4[])
FROM generate_series(1, 24) g;
SET enable_seqscan = off;
-- For each bit width, the three encodings must return identical rankings AND
-- (for f32) identical distances.  Small block size forces multi-chunk terms.
DO $$
DECLARE
  q_terms int4[] := ARRAY[2, 5, 3];
  q_weights float4[] := ARRAY[1.0, 1.0, 1.0];
  encs text[] := ARRAY['offset16_soa', 'varint', 'bitpacked'];
  bits int[] := ARRAY[0, 8, 16];
  b int;
  e text;
  baseline_ids int[];
  baseline_dist numeric[];
  ids int[];
  dist numeric[];
BEGIN
  SET LOCAL enable_seqscan = off;
  FOREACH b IN ARRAY bits LOOP
    baseline_ids := NULL;
    FOREACH e IN ARRAY encs LOOP
      EXECUTE format('DROP INDEX IF EXISTS bp_idx');
      EXECUTE format($f$CREATE INDEX bp_idx ON bp USING turbohybrid (s sparse_ip_turbohybrid_ops)
                        WITH (sparse_quant_bits = %s, sparse_postings_encoding = %L, sparse_block_size = 4)$f$, b, e);
      SELECT array_agg(id ORDER BY rn), array_agg(round(d::numeric, 4) ORDER BY rn)
        INTO ids, dist
      FROM (
        SELECT id,
               (s <~*> turbohybrid_query(sparse_query => turbohybrid_sparse_vector_build(q_terms, q_weights),
                                         sparse_k => 50, final_k => 50)) AS d,
               row_number() OVER (ORDER BY s <~*> turbohybrid_query(
                 sparse_query => turbohybrid_sparse_vector_build(q_terms, q_weights),
                 sparse_k => 50, final_k => 50)) AS rn
        FROM bp
        ORDER BY s <~*> turbohybrid_query(sparse_query => turbohybrid_sparse_vector_build(q_terms, q_weights),
                                          sparse_k => 50, final_k => 50)
        LIMIT 20) q;
      IF baseline_ids IS NULL THEN
        baseline_ids := ids;
        baseline_dist := dist;
      ELSE
        IF ids IS DISTINCT FROM baseline_ids THEN
          RAISE EXCEPTION 'bits=% encoding=% ranking % != baseline %', b, e, ids, baseline_ids;
        END IF;
        -- f32 must be bit-exact across encodings; q8/q16 share codes so also exact.
        IF dist IS DISTINCT FROM baseline_dist THEN
          RAISE EXCEPTION 'bits=% encoding=% distances % != baseline %', b, e, dist, baseline_dist;
        END IF;
      END IF;
    END LOOP;
  END LOOP;
  RAISE NOTICE 'bitpacked == offset16_soa == varint across bits {0,8,16}';
END $$;
NOTICE:  index "bp_idx" does not exist, skipping
ERROR:  value 4 out of bounds for option "sparse_block_size"
DETAIL:  Valid values are between "16" and "65536".
CONTEXT:  SQL statement "CREATE INDEX bp_idx ON bp USING turbohybrid (s sparse_ip_turbohybrid_ops)
                        WITH (sparse_quant_bits = 0, sparse_postings_encoding = 'offset16_soa', sparse_block_size = 4)"
PL/pgSQL function inline_code_block line 19 at EXECUTE
-- The bitpacked index reports its encoding + runs WAND (block-max, multi-chunk).
CREATE INDEX bp_bpk ON bp USING turbohybrid (s sparse_ip_turbohybrid_ops)
  WITH (sparse_quant_bits = 8, sparse_postings_encoding = bitpacked, sparse_block_size = 4);
ERROR:  value 4 out of bounds for option "sparse_block_size"
DETAIL:  Valid values are between "16" and "65536".
DROP INDEX bp_idx;
ERROR:  index "bp_idx" does not exist
DO $$
DECLARE st jsonb;
BEGIN
  SET LOCAL enable_seqscan = off;
  PERFORM id FROM bp ORDER BY s <~*> turbohybrid_query(
    sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[]),
    sparse_k => 50) LIMIT 10;
  st := turbohybrid_last_scan_stats();
  IF st->>'sparse_postings_encoding' != 'bitpacked' THEN
    RAISE EXCEPTION 'expected bitpacked encoding stat: %', st->>'sparse_postings_encoding';
  END IF;
  IF st->>'sparse_used_wand' != 'true' THEN
    RAISE EXCEPTION 'expected WAND on bitpacked multi-chunk term: %', st;
  END IF;
END $$;
-- Concrete ranking for the high-df descending-weight term (sanity).
SELECT id FROM bp ORDER BY s <~*> turbohybrid_query(
  sparse_query => turbohybrid_sparse_vector_build(ARRAY[2]::int4[], ARRAY[1.0]::float4[])) LIMIT 5;
 id 
