SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
RESET client_min_messages;
CREATE TABLE documents (
	id integer PRIMARY KEY,
	embedding vector(3) NOT NULL,
	body_tsv tsvector NOT NULL
);
INSERT INTO documents VALUES
	(1, '[1,0,0]', to_tsvector('simple', 'fast postgres search')),
	(2, '[0.9,0.1,0]', to_tsvector('simple', 'fast vector search')),
	(3, '[0,1,0]', to_tsvector('simple', 'lexical postgres index')),
	(4, '[0,0,1]', to_tsvector('simple', 'unrelated document'));
CREATE INDEX documents_idx ON documents USING turbohybrid (
	embedding vector_cosine_turbohybrid_ops,
	body_tsv bm25_tsvector_turbohybrid_ops
) WITH (exact_storage = on);
SET enable_seqscan = off;
SELECT array_agg(id ORDER BY distance, id) AS dense_order
FROM (
	SELECT id, embedding <~> turbohybrid_query(
		vector_query => '[1,0,0]'::vector,
		dense_k => 4,
		final_k => 3) AS distance
	FROM documents
	ORDER BY distance
	LIMIT 3
) ranked;
 dense_order 
-------------
 {1,2,3}
(1 row)

SELECT array_agg(id ORDER BY distance, id) AS hybrid_order
FROM (
	SELECT id, embedding <~> turbohybrid_query(
		vector_query => '[1,0,0]'::vector,
		text_query => to_tsquery('simple', 'postgres'),
		dense_k => 4,
		bm25_k => 4,
		final_k => 2) AS distance
	FROM documents
	ORDER BY distance
	LIMIT 2
) ranked;
 hybrid_order 
--------------
 {1,3}
(1 row)

INSERT INTO documents VALUES
	(5, '[0.99,0.01,0]', to_tsvector('simple', 'postgres extension'));
DELETE FROM documents WHERE id = 1;
SELECT array_agg(id ORDER BY distance, id) AS updated_order
FROM (
	SELECT id, embedding <~> turbohybrid_dense_query('[1,0,0]'::vector, 2, 4) AS distance
	FROM documents
	ORDER BY distance
	LIMIT 2
) ranked;
 updated_order 
---------------
 {5,2}
(1 row)

RESET enable_seqscan;
DROP TABLE documents;
