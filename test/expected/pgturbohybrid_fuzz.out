SET client_min_messages = warning;
CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS pgturbohybrid;
RESET client_min_messages;
DO $$
BEGIN
	PERFORM ''::turbohybrid_multivector;
	RAISE EXCEPTION 'empty multivector input was accepted';
EXCEPTION WHEN invalid_text_representation THEN NULL;
END
$$;
DO $$
BEGIN
	PERFORM turbohybrid_multivector(ARRAY['[1,0]'::vector, '[1,0,0]'::vector]);
	RAISE EXCEPTION 'mixed dimensions were accepted';
EXCEPTION WHEN data_exception THEN NULL;
END
$$;
DO $$
BEGIN
	PERFORM turbohybrid_multivector_subvector(
		turbohybrid_multivector(ARRAY['[1,0]'::vector]), 2);
	RAISE EXCEPTION 'out-of-range token was accepted';
EXCEPTION WHEN array_subscript_error THEN NULL;
END
$$;
